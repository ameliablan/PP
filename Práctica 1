let rec leibniz n acc =
  if n = 0 then acc
  else
    let term =
      ((-1.) ** float_of_int (n mod 2))
      /. float_of_int (2 * n + 1)
    in
    leibniz (n - 1) (acc +. term)

let () =
  let pi = 4. *. leibniz 200000 0. in
  print_float pi;
  print_newline ()

