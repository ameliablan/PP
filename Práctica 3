(*Ejercicio 3*)

let rec sum_to = function
  | 0 -> 0
  | n -> n + sum_to (n - 1)
let rec exp_2 = function
  | 0 -> 1
  | n -> 2 * exp_2 (n - 1)
let rec num_digits = function
  | n when n < 0 -> num_digits (-n)
  | n when n < 10 -> 1
  | n -> 1 + num_digits (n / 10)
let rec sum_digits = function
  | n when n < 0 -> sum_digits (-n)
  | n when n < 10 -> n
  | n -> (n mod 10) + sum_digits (n / 10)
