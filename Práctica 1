let rec fact n =
  if n = 0 then 1
  else n * fact (n - 1)

let rec serie k acc =
  if k = 0 then acc
  else serie (k - 1) (acc +. 1. /. float_of_int (fact k))

let () =
  let e = serie 15 1. in
  print_float e

